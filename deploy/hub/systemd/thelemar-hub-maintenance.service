[Unit]
Description=Run bounded Campaign Hub maintenance
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
RuntimeDirectory=thelemar-hub
WorkingDirectory=/home/ubuntu/ThelemarTools
ExecStartPre=/usr/bin/docker image inspect --format={{.Id}} thelemartools-hub-bff
ExecStart=/usr/bin/flock -n /run/thelemar-hub/maintenance.lock /usr/bin/docker compose --env-file .env.hub -f compose.hub.yml -f compose.hub.public.yml --profile maintenance run --interactive=false -T --rm --no-deps --pull never maintenance
TimeoutStartSec=1h
Nice=10

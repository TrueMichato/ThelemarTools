[Unit]
Description=Run bounded Campaign Hub maintenance
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
RuntimeDirectory=thelemar-hub
WorkingDirectory=/home/ubuntu/ThelemarTools
ExecStart=/usr/bin/python3 /home/ubuntu/ThelemarTools/deploy/hub/release-helper.py recovery-job-run --state /home/ubuntu/.local/state/thelemar-hub/recovery/active-fallback.tsv --env /home/ubuntu/.local/state/thelemar-hub/recovery/active-fallback.env --blocked /home/ubuntu/.local/state/thelemar-hub/recovery/active-fallback.blocked --admission-lock /run/lock/thelemar-hub-release.lock --job-lock /run/thelemar-hub/maintenance.lock -- /usr/bin/docker compose --project-directory /home/ubuntu/ThelemarTools --env-file .env.hub -f compose.hub.yml -f compose.hub.public.yml -f /etc/thelemar-hub/compose.hub.recovery-mode.yml --profile maintenance run --interactive=false -T --rm --no-deps --pull never maintenance
TimeoutStartSec=1h
Nice=10

{
	email {$HUB_ACME_EMAIL}
}

{$HUB_PUBLIC_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy bff:5052
	}

	handle /auth/* {
		reverse_proxy bff:5052
	}

	handle /ws/* {
		reverse_proxy bff:5052
	}

	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		reverse_proxy static:80
	}
}

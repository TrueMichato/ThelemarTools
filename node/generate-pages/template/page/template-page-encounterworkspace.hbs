<!DOCTYPE html>
<html lang="en">

{{> "head" }}

<body>

{{> "overlayNoise" }}

<div class="viewport-wrapper">
	{{> "adLeaderboard" }}
	{{> "navbar" }}

	<!--
	THESIS: Saved Bestiary encounters become independent, selectable working instances, not edits to pins.
	OWN-WORLD: Bestiary's compact statblocks, site buttons, neutral roster rail, and restrained blue target selection.
	STORY: Choose a saved list, see every counted monster together, select individual targets, return after reload.
	FIRST VIEWPORT: Source/list action above a roster rail and multi-statblock field; omissions remain visible above both.
	FORM: Familiar DM tool workspace, inherited from Bestiary rather than a new visual world.
	-->
	<main class="ew container" id="encounter-workspace" aria-busy="true">
		<header class="ew__header">
			<div>
				<h2>Encounter Workspace</h2>
				<p>Make a working copy of a saved Bestiary pinned list. Your original list stays untouched.</p>
			</div>
			<div class="ew__actions">
				<button type="button" class="ve-btn ve-btn-primary" id="ew-choose" disabled>Choose saved list</button>
				<a href="bestiary.html" class="ve-btn ve-btn-default">Bestiary</a>
			</div>
		</header>

		<p class="ew__status" id="ew-status" role="status" aria-live="polite">Loading working encounter...</p>

		<section class="ew__content" id="ew-workspace" aria-label="Working encounter" hidden>
			<header class="ew__source">
				<div>
					<h2 id="ew-name"></h2>
					<p>Working copy · source list will not change</p>
				</div>
				<p id="ew-summary" role="status" aria-live="polite"></p>
			</header>
			<div class="ew__notices" id="ew-notices" aria-label="Entries not loaded" hidden></div>
			<section class="ew__operations" aria-label="Actions for selected monsters">
				<div class="ew__operation">
					<h3>Roll for selected</h3>
					<div class="ew__controls">
						<label for="ew-roll-type">Roll</label>
						<select class="ve-form-control" id="ew-roll-type"></select>
						<label for="ew-roll-key">Using</label>
						<select class="ve-form-control" id="ew-roll-key"></select>
						<label for="ew-roll-mode">Mode</label>
						<select class="ve-form-control" id="ew-roll-mode">
							<option value="normal">Normal</option>
							<option value="advantage">Advantage</option>
							<option value="disadvantage">Disadvantage</option>
						</select>
						<button type="button" class="ve-btn ve-btn-primary" id="ew-roll">Roll selected</button>
					</div>
					<p class="ew__operation-help" id="ew-roll-hint"></p>
				</div>
				<div class="ew__operation">
					<h3>Conditions</h3>
					<div class="ew__controls">
						<label for="ew-condition">Condition</label>
						<select class="ve-form-control" id="ew-condition"></select>
						<button type="button" class="ve-btn ve-btn-primary" id="ew-condition-add">Apply to selected</button>
						<button type="button" class="ve-btn ve-btn-default" id="ew-condition-remove">Remove from selected</button>
					</div>
					<p class="ew__operation-help">Conditions are saved per monster; remove a chip from a single monster below.</p>
				</div>
				<div class="ew__operation">
					<h3>Selected monsters' HP</h3>
					<div class="ew__controls">
						<label for="ew-hp-expression">Damage / heal / set</label>
						<input class="ve-form-control ew__hp-expression" id="ew-hp-expression" type="text" placeholder="8d6, +12, -30, =15" aria-describedby="ew-hp-hint">
						<label class="ew__inline-check"><input id="ew-hp-half" type="checkbox"> Half damage</label>
						<button type="button" class="ve-btn ve-btn-primary" id="ew-hp-apply">Apply HP</button>
						<button type="button" class="ve-btn ve-btn-default" id="ew-hp-undo">Undo HP</button>
					</div>
					<p class="ew__operation-help" id="ew-hp-hint">Bare numbers damage; + heals, - damages, = sets. Dice roll once for the batch. Unset HP targets are skipped.</p>
				</div>
				<div class="ew__operation">
					<h3>Initiative</h3>
					<div class="ew__controls">
						<label for="ew-init-mode">Roll mode</label>
						<select class="ve-form-control" id="ew-init-mode">
							<option value="normal">Normal</option>
							<option value="advantage">Advantage</option>
							<option value="disadvantage">Disadvantage</option>
						</select>
						<button type="button" class="ve-btn ve-btn-primary" id="ew-init-roll">Roll selected initiative</button>
					</div>
					<p class="ew__operation-help">Uses each monster's initiative bonus as a Dexterity check, including applicable conditions and area modifiers. Edit a total on its statblock below.</p>
				</div>
				<section class="ew__operation ew__turns" aria-label="Turn order">
					<div class="ew__turns-header">
						<h3>Turn order</h3>
						<p id="ew-round-status" role="status" aria-live="polite"></p>
					</div>
					<div class="ew__controls">
						<button type="button" class="ve-btn ve-btn-primary" id="ew-turn-start">Start turns</button>
						<button type="button" class="ve-btn ve-btn-default" id="ew-turn-next">Next turn</button>
						<button type="button" class="ve-btn ve-btn-default" id="ew-turn-reset">Reset turns</button>
					</div>
					<ol id="ew-turn-order" class="ew__turn-order"></ol>
					<p id="ew-init-unrolled" class="ew__operation-help"></p>
				</section>
				<section class="ew__results" id="ew-results" aria-label="Roll results" hidden>
					<h3>Roll results</h3>
					<p id="ew-roll-summary" role="status" aria-live="polite"></p>
					<div id="ew-result-table" class="ew__results-scroll"></div>
				</section>
				<details class="ew__effect-tools">
					<summary id="ew-effects-summary">Area effects — traits, lair notes &amp; roll modifiers</summary>
					<div class="ew__effect-tools-grid">
						<div class="ew__operation">
							<h3>Area traits &amp; lair notes</h3>
							<div class="ew__effect-form">
								<label for="ew-note-kind">Note type</label>
								<select class="ve-form-control" id="ew-note-kind">
									<option value="trait">Area trait</option>
									<option value="lair">Lair-action note (manual)</option>
								</select>
								<label for="ew-note-name">Name</label>
								<input class="ve-form-control" id="ew-note-name" type="text" placeholder="e.g. Choking mist">
								<label for="ew-note-description">Description</label>
								<textarea class="ve-form-control" id="ew-note-description" rows="2" placeholder="What should the DM remember?"></textarea>
								<button type="button" class="ve-btn ve-btn-primary" id="ew-note-add">Add to selected</button>
							</div>
							<div class="ew__effect-remove">
								<label for="ew-note-remove">Applied note</label>
								<select class="ve-form-control" id="ew-note-remove"></select>
								<button type="button" class="ve-btn ve-btn-default" id="ew-note-remove-selected">Remove from selected</button>
							</div>
							<p class="ew__operation-help">Notes are reminders only. Lair actions are not triggered or rolled automatically.</p>
						</div>
						<div class="ew__operation">
							<h3>Area roll modifiers</h3>
							<div class="ew__effect-form">
								<label for="ew-preset">Desecrated Ground rule</label>
								<select class="ve-form-control" id="ew-preset" aria-describedby="ew-preset-detail"></select>
								<p class="ew__operation-help" id="ew-preset-detail"></p>
								<button type="button" class="ve-btn ve-btn-primary" id="ew-preset-add">Apply to selected undead</button>
							</div>
							<div class="ew__effect-form">
								<h4>Custom roll modifier</h4>
								<label for="ew-mod-name">Name / source</label>
								<input class="ve-form-control" id="ew-mod-name" type="text" placeholder="e.g. Blessed mist">
								<fieldset class="ew__scopes">
									<legend>Affects</legend>
									<label><input id="ew-mod-check" type="checkbox" checked> Ability &amp; skill checks</label>
									<label><input id="ew-mod-save" type="checkbox"> Saving throws</label>
								</fieldset>
								<label for="ew-mod-mode">Roll mode</label>
								<select class="ve-form-control" id="ew-mod-mode">
									<option value="normal">No advantage change</option>
									<option value="advantage" selected>Advantage</option>
									<option value="disadvantage">Disadvantage</option>
								</select>
								<label for="ew-mod-bonus">Signed flat bonus</label>
								<input class="ve-form-control" id="ew-mod-bonus" type="text" inputmode="numeric" value="0" aria-describedby="ew-mod-help">
								<p class="ew__operation-help" id="ew-mod-help">Use a whole number such as +2, 0, or -3. Bonuses from different sources add together.</p>
								<button type="button" class="ve-btn ve-btn-primary" id="ew-mod-add">Add to selected</button>
							</div>
							<div class="ew__effect-remove">
								<label for="ew-mod-remove">Applied modifier</label>
								<select class="ve-form-control" id="ew-mod-remove"></select>
								<button type="button" class="ve-btn ve-btn-default" id="ew-mod-remove-selected">Remove from selected</button>
							</div>
							<p class="ew__operation-help">Only selected monsters are treated as standing in the area. Remove an effect from one monster using its statblock below.</p>
						</div>
					</div>
				</details>
			</section>
			<div class="ew__layout">
				<aside class="ew__rail" aria-label="Monster targets">
					<div class="ew__rail-header">
						<h3>Targets</h3>
						<div class="ew__selection-actions">
							<button type="button" class="ve-btn ve-btn-default ve-btn-xs" id="ew-all">All</button>
							<button type="button" class="ve-btn ve-btn-default ve-btn-xs" id="ew-none">None</button>
						</div>
					</div>
					<p class="ew__help">Choose monsters individually. Selection is saved for the next visit.</p>
					<div id="ew-roster" class="ew__roster"></div>
				</aside>
				<section class="ew__statblocks" id="ew-statblocks" aria-label="Monster statblocks"></section>
			</div>
		</section>
	</main>
</div>

{{> "adFooter" }}
{{> "scripts" }}

</body>
</html>

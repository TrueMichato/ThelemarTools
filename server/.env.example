# Public origin serving both the static site and the Hub BFF. No trailing path.
HUB_APP_ORIGIN=https://tools.example.com
HUB_HOST=127.0.0.1
HUB_PORT=5052

# Generate independently, e.g. `openssl rand -base64 48`.
HUB_COOKIE_SECRET=replace-with-at-least-32-random-characters
HUB_CSRF_SECRET=replace-with-a-different-32-character-secret
HUB_METRICS_TOKEN=replace-with-an-independent-32-character-token
HUB_LOG_LEVEL=info
HUB_AUTH_PROVIDERS=github
# Emergency-only comma-separated kill switch. The service fails closed if no provider remains.
HUB_AUTH_EMERGENCY_DISABLED_PROVIDERS=

# PostgreSQL connection. Production TLS is required unless HUB_DATABASE_SSL=false is explicitly set locally.
DATABASE_URL=postgresql://user:password@host:5432/thelemar_hub
HUB_DATABASE_SSL=true

# Leave empty when the BFF is directly internet-facing. Otherwise list only the reverse proxy CIDRs/IPs
# which replace (not append to) incoming forwarded headers.
HUB_TRUST_PROXY=
# DigitalOcean App Platform only: leave HUB_TRUST_PROXY empty and enable the provider-set client IP header.
# HUB_CLIENT_IP_HEADER=do-connecting-ip

# GitHub OAuth application callback:
# https://tools.example.com/auth/github/callback
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Discord and Google are first-enabled together after the layer-3 account-linking UI is deployed.
# Exact callbacks:
# https://tools.example.com/auth/discord/callback
# https://tools.example.com/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stable provider subjects only; never use email, login, handle, or display name.
HUB_ALLOWED_OAUTH_SUBJECTS=github:12345678
